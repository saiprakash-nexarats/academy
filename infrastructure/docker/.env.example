# ==========================================
# Nexarats Academy - Local Infrastructure Configuration
# ==========================================

# PostgreSQL 16 Foundation
POSTGRES_DB=nexarats_academy
POSTGRES_USER=nexarats_user
POSTGRES_PASSWORD=nexarats_secret_dev
POSTGRES_PORT=5432

# Redis 7 Foundation (Caching, Rate Limiting, Session Support)
REDIS_PASSWORD=nexarats_redis_dev
REDIS_PORT=6379

# MinIO (Local S3-Compatible Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=nexarats-media-local

# Core Backend Settings
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexarats_academy
DB_USERNAME=nexarats_user
DB_PASSWORD=nexarats_secret_dev
